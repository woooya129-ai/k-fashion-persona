# 본 파일은 빈 템플릿입니다. 실제 키는 ~/secrets/k-fashion/.env 에 둡니다.
# 실제 값은 로컬 환경 파일이나 셸 환경변수에만 둔다.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
HF_TOKEN=
KOSIS_API_KEY=
DATAGOKR_SERVICE_KEY=
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
KMA_APIHUB_AUTH_KEY=

# Optional: paste a KOSIS statisticsData API URL generated from the KOSIS URL builder.
# The app can use this with KOSIS_API_KEY to refresh the committed snapshot.
KOSIS_STATISTICS_DATA_URL=

# Optional: data.go.kr MOIS resident-registration population endpoint.
# The app can use this with DATAGOKR_SERVICE_KEY; without it reports use the snapshot.
MOIS_POPULATION_API_URL=

# Optional v0.8.0 context expansion keys.
# SGIS uses consumer key/secret to obtain an accessToken for S-Open API calls.
# KMA weather connector currently accepts only APIHub HTTPS endpoints and uses
# KMA_APIHUB_AUTH_KEY for authKey. The data.go.kr weather page is source
# reference only, not an active connector path.
SGIS_SPATIAL_API_URL=
SBDC_COMMERCIAL_API_URL=
KMA_WEATHER_API_URL=
KMA_FORECAST_NX=
KMA_FORECAST_NY=

# Optional v0.8.0 image description assist.
# Default app behavior stays OFF. Set both values only if you want the local UI
# to call an OpenAI vision-capable model for one editable concept draft.
KFPS_IMAGE_ASSIST_PROVIDER=openai
KFPS_IMAGE_ASSIST_MODEL=

# Optional: URL prefix where `docs/docs.html` is served locally
# (sidebar links in Streamlit). Default http://127.0.0.1:8510 when unset.
# KFPS_STATIC_DOCS_BASE=http://127.0.0.1:8510
