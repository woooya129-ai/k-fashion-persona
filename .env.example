# 본 파일은 빈 템플릿입니다. 실제 키는 ~/secrets/k-fashion/.env 에 둡니다.
# 실제 값은 로컬 환경 파일이나 셸 환경변수에만 둔다.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
HF_TOKEN=
KOSIS_API_KEY=
DATAGOKR_SERVICE_KEY=

# Optional: paste a KOSIS statisticsData API URL generated from the KOSIS URL builder.
# The app can use this with KOSIS_API_KEY to refresh the committed snapshot.
KOSIS_STATISTICS_DATA_URL=

# Optional: data.go.kr MOIS resident-registration population endpoint.
# The app can use this with DATAGOKR_SERVICE_KEY; without it reports use the snapshot.
MOIS_POPULATION_API_URL=



# Optional: URL prefix where `docs/docs.html` is served locally
# (sidebar links in Streamlit). Default http://127.0.0.1:8510 when unset.
# KFPS_STATIC_DOCS_BASE=http://127.0.0.1:8510
